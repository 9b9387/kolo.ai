# Copy to .env and adjust for your environment.

# Used by Prisma CLI (migrate/introspection) via prisma.config.ts
DATABASE_URL="mysql://kolo:kolo_dev@localhost:3307/kolo"

# Used by the app runtime (driver adapter) and ETL scripts
DB_HOST=localhost
DB_PORT=3307
DB_USER=kolo
DB_PASSWORD=kolo_dev
DB_NAME=kolo

# better-auth — generate with: openssl rand -base64 32
# (the app refuses to boot with a missing/short/placeholder secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
